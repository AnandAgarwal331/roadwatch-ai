# The Supabase project backing this app - a Supabase Edge Function (not
# FastAPI) plus Supabase Auth. Only the Next.js server reads these - the
# browser never calls Supabase directly, it goes through /api/proxy/* and
# /api/auth/*. The publishable key is not a secret (it is designed to be
# public), so NEXT_PUBLIC_ is correct here even though these are only read
# server-side today.
NEXT_PUBLIC_SUPABASE_URL=https://yogtvvbktmodvbarpvhm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fEw3BdVYfCg_eSX1BYx_Zw_wfDzmfMb
